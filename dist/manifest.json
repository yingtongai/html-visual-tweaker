{
  "manifest_version": 3,
  "name": "HTML Visual Tweaker",
  "version": "0.8.1",
  "description": "Visually tune HTML pages and keep per-page style history.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads"],
  "action": {
    "default_title": "Toggle HTML editor"
  },
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["content/editor.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["file:///*"]
}
